# Apache Server Configuration for Hostinger Static Site Hosting
DirectoryIndex index.html en/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect root domain to /en/
  RewriteRule ^$ /en/ [R=301,L]

  # Allow existing static files or directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route directory paths to their index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>
