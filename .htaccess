# Sparkers Games — Apache Configuration for Hostinger Static Hosting
# Static files are at the repo root (copied from out/ by deploy.js)

DirectoryIndex index.html en/index.html

Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect old thin encyclopedia page to new pillar blog post
  RewriteRule ^en/encyclopedia/icebreakers-for-work/?$ https://www.sparkersgames.com/en/blog/icebreakers-for-work/ [R=301,L]

  # Explicit 404 for removed RSS feed
  RewriteRule ^rss\.xml$ - [R=404,L]

  # 301 Redirect query-parameter audience views (e.g. /en/play?aud=office) to clean URLs (/en/play/office/)
  RewriteCond %{QUERY_STRING} ^aud=([a-z0-9-]+)$ [NC]
  RewriteRule ^en/play/?$ https://www.sparkersgames.com/en/play/%1/? [R=301,L]

  # 1. Collapse /en/en/ duplicate prefix and redirect to canonical host with trailing slash in 1 hop
  RewriteCond %{HTTP_HOST} ^(www\.)?sparkersgames\.com$ [NC]
  RewriteRule ^en/en/(.*)/?$ https://www.sparkersgames.com/en/$1/ [R=301,L]

  # 2. Redirect http and/or non-www requests to https://www. and enforce trailing slash in 1 hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^sparkersgames\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/_next
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://www.sparkersgames.com/$1/ [R=301,L]

  # 3. Standard Force HTTPS and WWW for all remaining requests (files, already-slashed URLs)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^sparkersgames\.com$ [NC]
  RewriteRule ^(.*)$ https://www.sparkersgames.com/$1 [R=301,L]

  # 4. Enforce trailing slash locally for canonical host requests (excluding files, assets)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/_next
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 5. Serve _next/ static assets directly
  RewriteRule ^_next/ - [L]

  # 6. Serve existing static files directly (favicon, svg, xml, txt, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 7. Serve existing directories with their index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 8. Redirect bare root to /en/
  RewriteRule ^$ /en/ [R=301,L]

  # 9. Route clean URL paths to their pre-built index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)/?$ /$1/index.html [L]

  # 10. Fallback: serve en/ homepage
  RewriteRule ^ /en/index.html [L]
</IfModule>

# Performance: cache static assets aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Custom error page
ErrorDocument 404 /404.html
